generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Salary {
  id                 String   @id @default(cuid())
  company            String
  role               String
  level              String
  location           String
  experience_years   Float
  base_salary        Float
  bonus              Float    @default(0)
  stock              Float    @default(0)
  total_compensation Float
  confidence_score   Float
  created_at         DateTime @default(now())

  @@unique([company, role, level, location, experience_years, base_salary, bonus, stock])
  @@index([company])
  @@index([role])
  @@index([level])
  @@index([location])
  @@index([total_compensation])
}
